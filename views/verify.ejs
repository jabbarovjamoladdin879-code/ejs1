<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SignUp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
</head>

<body>
  <div class="container">
      <h1>Verify</h1>
    <form action="/verify" method="post" class="w-25" id="form">

      <label for="otp" class="form-label mb-2">otp</label>
      <input type="number" class="form-control mb-3" id="otp" placeholder="123456..." name="otp">

      <input type="email" hidden class="form-control mb-3" id="email" name="email">

      <button type="submit" class="btn-solid mt-5 theme-primary">Verify</button>
    </form>

    <% if (token) { %>
    <script>
      const token = <%- JSON.stringify(token) %>;

      localStorage.setItem("token", token);

      window.location.replace("/get_all_products");
    </script>
    <% } %>
  </div>

  <script>

    const form = document.querySelector("#form")

    form.addEventListener("submit", function(event) {
      const email = localStorage.getItem("email")

      document.querySelector("#email").value = email
    })
  </script>
    <!-- bootstrap  -->
  <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
    crossorigin="anonymous"></script>
</body>

</html>
